# Juice Garden — Environment Configuration Template
# Copy to .env and adjust as needed.

# ──────────────────────────────────────────────
# Host Port Bindings
# ──────────────────────────────────────────────
# Nginx main port (Garden Fresh app + challenge board + attacker.lab vhost)
NGINX_HTTP_PORT=80
# Nginx CS-02 cross-origin port (exploit-server same-site/cross-origin attack pages)
NGINX_EXPLOIT_PORT=8081

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_DB=garden_fresh
POSTGRES_USER=garden
POSTGRES_PASSWORD=garden_secret_changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Node.js Garden Fresh App
# ──────────────────────────────────────────────
NODE_ENV=production
NODE_PORT=3000

# JWT signing — RSA key pair is generated at startup; private key stored here for AUTH-02
# DO NOT change at runtime; affects JWT verification for AUTH-01 and AUTH-02
JWT_KID_KEY_PATH=/app/keys/hmac.key

# Session cookie settings
SESSION_SECRET=session_secret_changeme
# SESSION_SAMESITE controls the SameSite attribute on session cookies
# Values: Lax (default) or Strict (for CS-03 negative verification check)
SESSION_SAMESITE=Lax

# staffSessionProof HMAC signing key
STAFF_PROOF_SECRET=staff_proof_secret_changeme

# ──────────────────────────────────────────────
# Flask Challenge Platform
# ──────────────────────────────────────────────
FLASK_SECRET_KEY=flask_secret_changeme
FLASK_PORT=5000

# ──────────────────────────────────────────────
# Bot Account Credentials (seeded into Garden Fresh)
# ──────────────────────────────────────────────
STAFF_BOT_EMAIL=staff.bot@garden.lab
STAFF_BOT_PASSWORD=StaffBot2024!
MANAGER_BOT_EMAIL=manager.bot@garden.lab
MANAGER_BOT_PASSWORD=ManagerBot2024!
ADMIN_BOT_EMAIL=admin.bot@garden.lab
ADMIN_BOT_PASSWORD=AdminBot2024!

# ──────────────────────────────────────────────
# Victim Bot
# ──────────────────────────────────────────────
BOT_GARDEN_URL=http://garden.lab:80
